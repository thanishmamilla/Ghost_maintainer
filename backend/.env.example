# Copy to backend/.env and fill in what you need. Everything works with the defaults.

# GitHub: read-only token raises rate limits; a write token is only used when DRY_RUN=false
GITHUB_TOKEN=
DRY_RUN=true

# Optional LLM. Every feature works without it; a key only adds model-assisted
# review findings and LLM-proposed migrations. Any OpenAI-compatible endpoint works.
#   Ollama (local, no key):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5-coder:7b
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.6-flash
# Check whatever you configure with:  python -m app.llm_check
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

FRONTEND_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=10
METADATA_CONCURRENCY=8
METADATA_CACHE_TTL_SECONDS=900

# auto | docker | local_restricted
SANDBOX_MODE=auto
SANDBOX_TIMEOUT_SECONDS=180
# Must be explicitly true to run untrusted repo tests without container isolation
ALLOW_UNTRUSTED_LOCAL_EXECUTION=false

LOG_LEVEL=INFO
OFFLINE_FIXTURES=false